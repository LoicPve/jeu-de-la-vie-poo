        <!-- ==================== Légende UML ==================== -->
        <mxCell id="note-legende" value="&lt;b&gt;Légende UML &amp;amp; Architecture POO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Violet («abstract»)&lt;/b&gt; : Classe abstraite / contrat polymorphique&lt;br&gt;• &lt;b&gt;Bleu&lt;/b&gt; : Classe concrète du cœur MVP&lt;br&gt;• &lt;b&gt;Jaune («Bonus»)&lt;/b&gt; : Extension (cellule obstacle)&lt;br&gt;• &lt;b&gt;Losange plein (◆)&lt;/b&gt; : Composition (durée de vie liée)&lt;br&gt;• &lt;b&gt;Losange vide (◇)&lt;/b&gt; : Agrégation (règle injectable / Strategy)&lt;br&gt;• &lt;b&gt;Flèche triangle vide (▷)&lt;/b&gt; : Héritage / Spécialisation&lt;br&gt;• &lt;b&gt;Flèche pointillée (- - &amp;gt;)&lt;/b&gt; : Dépendance d'utilisation" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacing=10;size=18;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="470" width="440" height="190" as="geometry" />
        </mxCell>

