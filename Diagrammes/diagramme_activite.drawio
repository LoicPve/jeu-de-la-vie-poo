          <mxGeometry x="1345" y="255" width="460" height="52" as="geometry" />
        </mxCell>

        <mxCell id="sub-call-regle" value="Appeler &lt;b&gt;regle.calculerProchainEtat(etatActuel, nbVoisins)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1355" y="330" width="440" height="38" as="geometry" />
        </mxCell>

        <mxCell id="sub-dec-obst" value="etatActuel.estObstacle() ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="390" width="190" height="64" as="geometry" />
        </mxCell>

        <mxCell id="sub-res-obst" value="&lt;b&gt;etatActuel.cloner()&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Bonus obstacle figé)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1740" y="399" width="165" height="46" as="geometry" />
        </mxCell>

        <mxCell id="sub-dec-viv" value="etatActuel.estVivante() ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1485" y="480" width="180" height="64" as="geometry" />
        </mxCell>

        <mxCell id="sub-dec-23" value="nbVoisins == 2 ou 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1265" y="565" width="175" height="62" as="geometry" />
        </mxCell>

        <mxCell id="sub-dec-3" value="nbVoisins == 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1635" y="565" width="165" height="62" as="geometry" />
        </mxCell>

        <mxCell id="sub-res-clone" value="etatActuel.cloner()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="660" width="120" height="38" as="geometry" />
        </mxCell>
        <mxCell id="sub-res-mort1" value="new EtatMort()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1365" y="660" width="115" height="38" as="geometry" />
        </mxCell>
        <mxCell id="sub-res-viv" value="new EtatVivant()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1590" y="660" width="120" height="38" as="geometry" />
        </mxCell>
        <mxCell id="sub-res-mort2" value="new EtatMort()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1735" y="660" width="115" height="38" as="geometry" />
        </mxCell>

        <mxCell id="sub-affect" value="Affecter le nouvel état dans la grille tampon (&lt;b&gt;setEtat&lt;/b&gt;)&lt;br&gt;et mettre &lt;b&gt;aEvolue = true&lt;/b&gt; si l'état a changé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1325" y="735" width="490" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sub-swap" value="Remplacer &lt;b&gt;m_cellules&lt;/b&gt; par la grille tampon (t+1)&lt;br&gt;et retourner &lt;b&gt;aEvolue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1355" y="830" width="440" height="52" as="geometry" />
        </mxCell>

        <mxCell id="sub-end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
