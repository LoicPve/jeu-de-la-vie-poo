        <mxCell id="sflow-viv-oui" value="[Oui]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sub-dec-viv" target="sub-dec-23">
