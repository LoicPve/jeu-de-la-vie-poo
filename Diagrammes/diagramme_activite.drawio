        <!-- ==================== LÉGENDE UML ==================== -->
        <mxCell id="note-legende-act" value="&lt;b&gt;Légende UML — Diagramme d'Activité&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Disque noir&lt;/b&gt; : Nœud initial (début de l'activité)&lt;br&gt;• &lt;b&gt;Disque entouré&lt;/b&gt; : Nœud final (fin de l'exécution)&lt;br&gt;• &lt;b&gt;Rectangle arrondi bleu&lt;/b&gt; : Action métier / IHM&lt;br&gt;• &lt;b&gt;Rectangle arrondi violet&lt;/b&gt; : Appel polymorphique (&lt;i&gt;Regle&lt;/i&gt; / &lt;i&gt;Grille::actualiser&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Losange jaune&lt;/b&gt; : Nœud de décision avec condition de garde &lt;b&gt;[garde]&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Double tampon&lt;/b&gt; : Toutes les cellules à t+1 sont calculées avant de remplacer m_cellules" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacing=12;size=18;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1025" width="790" height="190" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
