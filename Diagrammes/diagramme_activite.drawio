        <mxCell id="sflow-23-oui" value="[Oui]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sub-dec-23" target="sub-res-clone">
          <mxGeometry x="-0.2" y="12" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="sflow-23-non" value="[Non]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sub-dec-23" target="sub-res-mort1">
          <mxGeometry x="-0.2" y="-12" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="sflow-3-oui" value="[Oui]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sub-dec-3" target="sub-res-viv">
          <mxGeometry x="-0.2" y="12" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
