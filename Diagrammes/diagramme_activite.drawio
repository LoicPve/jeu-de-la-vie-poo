        </mxCell>
        <mxCell id="sflow-obst-oui" value="[Oui]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=11;fontStyle=1;" edge="1" parent="1" source="sub-dec-obst" target="sub-res-obst">
